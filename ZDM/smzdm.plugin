#!name = 什么值得买自动签到
#!desc = 每日自动签到什么值得买：打开什么值得买 App 触发签到请求，自动捕获 Cookie 与 Body，每日 08:30 定时签到并推送结果。使用前需在 Loon 安装并信任 CA 证书、开启 MITM。
#!author = leafshow
#!homepage = https://github.com/leafshow/loon-scripts
#!icon = https://raw.githubusercontent.com/Orz-3/mini/master/Color/smzdm.png
#!date = 2026-09-21
#!openUrl = https://github.com/leafshow/loon-scripts/tree/main/ZDM

[Argument]
自动签到 = ARG_SWITCH, default=true, label=每日 08:30 定时签到
凭证捕获 = ARG_SWITCH, default=true, label=打开App自动捕获Cookie与Body

[Script]
http-request ^https:\/\/user-api\.smzdm\.com\/checkin$ script-path=https://raw.githubusercontent.com/leafshow/loon-scripts/main/ZDM/smzdm_cookie_capture.js, requires-body=true, tag=什么值得买凭证捕获, enable={{凭证捕获}}
cron "30 8 * * *" script-path=https://raw.githubusercontent.com/leafshow/loon-scripts/main/ZDM/smzdm_signin.js, tag=什么值得买签到, enable={{自动签到}}

[MITM]
hostname = user-api.smzdm.com
