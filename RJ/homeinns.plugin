#!name = 首旅如家自动签到
#!desc = 每日自动签到首旅如家：打开如家 App/活动页触发签到请求，自动捕获 Cookie 与 CSRF Token（签到成功后还会自动续期 Cookie），每日 09:20 定时签到并推送如愿豆奖励。使用前需在 Loon 安装并信任 CA 证书、开启 MITM。
#!author = leafshow
#!homepage = https://github.com/leafshow/loon-scripts
#!icon = https://raw.githubusercontent.com/Orz-3/mini/master/Color/homeinns.png
#!date = 2026-09-21
#!openUrl = https://github.com/leafshow/loon-scripts/tree/main/RJ

[Argument]
自动签到 = ARG_SWITCH, default=true, label=每日 09:20 定时签到
凭证捕获 = ARG_SWITCH, default=true, label=触发签到请求时自动捕获凭证

[Script]
http-request ^https:\/\/idea\.homeinns\.com\/event\/check_in script-path=https://raw.githubusercontent.com/leafshow/loon-scripts/main/RJ/homeinns_cookie_capture.js, requires-body=false, tag=首旅如家凭证捕获, enable={{凭证捕获}}
cron "20 9 * * *" script-path=https://raw.githubusercontent.com/leafshow/loon-scripts/main/RJ/homeinns_checkin.js, tag=首旅如家签到, enable={{自动签到}}

[MITM]
hostname = idea.homeinns.com
